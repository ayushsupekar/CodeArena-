{
  "name": "codearena",
  "version": "1.0.0",
  "description": "Advanced coding platform with AI assistance and collaboration",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "node setup.js",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx tsx lib/seed.ts",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset && npm run db:seed",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "clean": "rm -rf .next out dist"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@prisma/client": "^5.22.0",
    "lucide-react": "^0.460.0",
    "next": "14.2.31",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.31",
    "postcss": "^8",
    "prettier": "^3.0.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5"
  },
  "keywords": [
    "coding",
    "interview",
    "leetcode",
    "algorithms",
    "collaboration",
    "nextjs"
  ],
  "author": "CodeArena Team",
  "license": "MIT"
}